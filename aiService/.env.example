# ===== Backend =====
BACKEND_URL=http://localhost:3000
AI_WEBHOOK_SECRET=replace_me

# ===== Scheduling (camera workers) =====
DETECT_INTERVAL_SECONDS=20
CAMERA_REFRESH_SECONDS=60

# ===== Detector =====
# 'mock' | 'yolo'
DETECTOR=yolo
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.4
TRAFFIC_VEHICLE_THRESHOLD=8

# Path tới YOLO fire model — dùng cho fire detection ở camera worker và YouTube hunter.
FIRE_MODEL_PATH=models/best.pt

# ===== Video sources =====
VIDEOS_DIR=videos
DEFAULT_VIDEO=default.mp4

# Mock detector
MOCK_DETECTION_PROBABILITY=0.3

# ===== YouTube Hunter =====
# Bật/tắt worker quét YouTube tìm video về cháy/hỏa hoạn.
ENABLE_YOUTUBE_HUNTER=false

# YouTube Data API key — lấy ở Google Cloud Console.
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Từ khoá search, ngăn cách bằng | hoặc ,
# Mỗi keyword sẽ search riêng (KHÔNG phải regex OR).
YOUTUBE_SEARCH_KEYWORDS=cháy lớn|hỏa hoạn|cháy nhà|cháy chợ|cháy chung cư|cháy xưởng

# Tần suất quét YouTube (giây). 180 = 3 phút. Đừng quá ngắn — quota YT có giới hạn.
YOUTUBE_POLL_INTERVAL_SECONDS=180
# Số kết quả tối đa lấy về MỖI keyword.
YOUTUBE_MAX_RESULTS=5

# Bao gồm cả video upload (VOD) trong N giờ gần nhất — không chỉ livestream.
# Khuyến khích bật vì 80%+ tin cháy ở VN nằm dưới dạng video upload của báo.
YOUTUBE_INCLUDE_VOD=true
YOUTUBE_VOD_HOURS=6

# Verify fire bằng YOLO: lấy mỗi YOLO_VERIFY_FRAME_SKIP frames 1 sample,
# tổng cộng tối đa YOLO_VERIFY_MAX_SAMPLES sample.
# Mặc định: 30 sample, mỗi 12 frame → ở 25fps là ~14s phủ qua video.
YOLO_VERIFY_MAX_SAMPLES=30
YOLO_VERIFY_FRAME_SKIP=12

# ===== Vision LLM verifier =====
# Gemini — verify multi-disaster type (fire/flood/landslide/storm/traffic).
# Lấy free key tại https://aistudio.google.com/app/apikey (free 15 RPM, 1M tokens/day).
# Để trống thì fallback YOLO fire-only model.
GOOGLE_API_KEY=

# Optional: ép tên model. Để trống thì code tự thử các phiên bản hiện hành.
# GEMINI_MODEL=gemini-2.5-flash

# ===== RSS Hunter =====
# Bật/tắt worker quét RSS báo VN tìm tin thiên tai.
# Khuyên bật vì free hoàn toàn, không quota như YouTube.
ENABLE_RSS_HUNTER=true

# Danh sách RSS feed URL, ngăn cách bằng `,`. Default đã có 3 báo lớn,
# chỉ cần override khi muốn thêm/bớt.
# RSS_FEEDS=https://vnexpress.net/rss/thoi-su.rss,https://tuoitre.vn/rss/tin-moi-nhat.rss,https://thanhnien.vn/rss/home.rss

# Poll mỗi N giây (default 600 = 10 phút).
RSS_POLL_INTERVAL_SECONDS=600

# Toạ độ fallback khi không extract được địa điểm (mặc định: trung tâm Q.1 TP.HCM)
DEFAULT_LAT=10.776889
DEFAULT_LNG=106.700806

# Nominatim user-agent (yêu cầu để dùng API miễn phí)
NOMINATIM_USER_AGENT=DisasterTraffic-AIService/0.1

# ===== Logging =====
LOG_LEVEL=INFO
