# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== CORS =====
# Comma-separated list of allowed origins. Use "*" only for development.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ===== MongoDB =====
# Get this from your MongoDB Atlas dashboard.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/disaster_traffic?retryWrites=true&w=majority

# ===== TomTom Traffic API =====
# Server proxies tiles to hide this key from clients. Never expose in HTML/JS.
TOMTOM_KEY=

# ===== AI / Webhook secret =====
# Required header `x-api-key` for POST /api/alerts (used by AI service to push events).
AI_WEBHOOK_SECRET=replace_me_with_a_long_random_string

# ===== JWT (Authentication) =====
JWT_SECRET=replace_me_with_a_long_random_string

# ===== Cross-source dedup =====
# Bán kính (mét) để gộp 2 alert cùng type/cùng ngày thành 1.
# 5000 = 5km. Tăng lên nếu thấy alerts trùng nhau quá rải.
DEDUP_RADIUS_METERS=5000
